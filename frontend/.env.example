# BankFlow Analytics Console — Frontend Configuration
# Copy this file to .env.local to customize local development settings.
# NEVER commit .env or .env.local with credentials to version control.

# BankFlow Reporting API Base URL
# When pointing to local FastAPI server (python -m bankflow serve):
VITE_BANKFLOW_API_BASE_URL=http://localhost:8000

# Optional Demo Mode Flag (true / false)
# When set to true, initializes the application in Demo Mode with synthetic fixtures.
# Note: The UI also provides a manual toggle between Connected and Demo modes.
VITE_DEMO_MODE=false
