# BankFlow Environment Configuration Example
# Copy this file to .env and fill in your local PostgreSQL credentials.
# NEVER commit .env to version control.

# PostgreSQL Connection Settings (Discrete)
# For local Docker Compose setup:
#   - user: postgres
#   - password: password or postgres
#   - port: 5432 (or 5433 if 5432 is in use by a local Windows service)
BANKFLOW_DB_HOST=localhost
BANKFLOW_DB_PORT=5432
BANKFLOW_DB_NAME=bankflow
BANKFLOW_DB_USER=postgres
BANKFLOW_DB_PASSWORD=postgres

# Dedicated Test Database (Must contain 'test' or end with '_test' for safety guard)
# Automatically created on startup in Docker Compose
BANKFLOW_TEST_DB_NAME=bankflow_test

# Optional Full Connection URLs (Takes precedence over discrete settings if provided)
# DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/bankflow
# TEST_DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/bankflow_test

# Pipeline Settings
BANKFLOW_REPORTING_TIMEZONE=UTC
BANKFLOW_DEFAULT_CURRENCY=USD
BANKFLOW_DEFAULT_SOURCE_SYSTEM=CORE_BANKING

# Reporting API Settings (Optional)
# Dedicated least-privilege reporting credentials (provisioned via sql/06_reporting_role.sql)
# If configured, BOTH user and password must be provided and non-empty. Never supply only one.
# For local setup, set password interactively using `\password bankflow_reporting_user` in psql.
# In CI/CD or production, retrieve credentials from a secret manager (AWS Secrets Manager, GCP Secret Manager, Vault).
# BANKFLOW_REPORTING_DB_USER=bankflow_reporting_user
# BANKFLOW_REPORTING_DB_PASSWORD=your_reporting_password_here
# BANKFLOW_API_HOST=127.0.0.1
# BANKFLOW_API_PORT=8000
# BANKFLOW_CORS_ORIGINS=https://bankflow-analytics-console.lovable.app,http://localhost:5173
