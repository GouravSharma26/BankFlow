# BankFlow Environment Configuration Example
# Copy this file to .env and fill in your local PostgreSQL credentials.
# NEVER commit .env to version control.

# PostgreSQL Connection Settings (Discrete)
BANKFLOW_DB_HOST=localhost
BANKFLOW_DB_PORT=5432
BANKFLOW_DB_NAME=bankflow
BANKFLOW_DB_USER=postgres
BANKFLOW_DB_PASSWORD=your_password_here

# Dedicated Test Database (Must contain 'test' or end with '_test' for safety guard)
BANKFLOW_TEST_DB_NAME=bankflow_test

# Optional Full Connection URLs (Takes precedence over discrete settings if provided)
# DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/bankflow
# TEST_DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/bankflow_test

# Pipeline Settings
BANKFLOW_REPORTING_TIMEZONE=UTC
BANKFLOW_DEFAULT_CURRENCY=USD
BANKFLOW_DEFAULT_SOURCE_SYSTEM=CORE_BANKING
